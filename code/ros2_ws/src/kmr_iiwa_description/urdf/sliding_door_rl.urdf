<?xml version="1.0"?>
<!-- Sliding door, RL training variant.

     Differences from sliding_door.urdf (the perception/classical asset):
       - AprilTag anchor links removed. RL observation is state-based (no
         camera in the loop), so the three near-massless tag links only
         hurt: a 15000:1 mass ratio inside one articulation is exactly the
         kind of thing that makes the PhysX articulation solver jitter
         during contact, which is the phase being trained.
       - Canonical names shared with revolute_door_rl.urdf:
             door_frame      static base link
             door_leaf       moving link
             door_dof_joint  the single DOF that "opens"
             handle_grasp    the link the gripper takes
         so one Isaac Lab env class indexes one joint and one link, and the
         door type becomes a randomisation parameter rather than a separate
         scenario with its own observation layout.

     Convert with merge-joints (folds handle_grasp into door_leaf; a fixed
     joint carries no dynamics, so this is a no-op on the physics) and
     make-instanceable (no per-prim materials here, unlike the gripper
     fingers). Result: 2 rigid bodies, 1 DOF.

     The <dynamics> values below are DEFAULTS ONLY. Resistance is set
     explicitly in the ArticulationCfg and randomised per-env at runtime via
     write_joint_{stiffness,damping,friction_coefficient}_to_sim. Do not
     tune the door by re-converting this file.

     Convention: door face normal = +X, slide direction along +Y,
     height along +Z. No latch. Handle diameter 28mm, matching the revolute
     door's lever, so a single gripper geometry works on both. -->
<robot name="sliding_door_rl">

  <!-- ===================== RAIL / FRAME (static) ===================== -->
  <link name="door_frame">
    <visual>
      <origin xyz="0 0.9 2.05" rpy="0 0 0"/>
      <geometry><box size="0.06 2.0 0.06"/></geometry>
      <material name="frame_grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.9 2.05" rpy="0 0 0"/>
      <geometry><box size="0.06 2.0 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.9 2.05"/>
      <mass value="30"/>
      <inertia ixx="10" iyy="0.02" izz="10" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===================== DOOR LEAF ===================== -->
  <link name="door_leaf">
    <visual>
      <origin xyz="0 0.425 1.0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.85 2.0"/></geometry>
      <material name="door_wood"><color rgba="0.72 0.52 0.30 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.425 1.0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.85 2.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.425 1.0"/>
      <mass value="15"/>
      <inertia ixx="5.90" iyy="5.00" izz="0.91" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- The DOF that opens. Prismatic here, revolute in the other asset -
       same name, so the env code never branches on door type. -->
  <joint name="door_dof_joint" type="prismatic">
    <parent link="door_frame"/>
    <child link="door_leaf"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.8" effort="200" velocity="1.0"/>
    <dynamics damping="8.0" friction="2.0"/>
  </joint>

  <!-- ===================== PULL HANDLE ===================== -->
  <!-- Vertical grip bar (r=0.014) standing off the door face along +X,
       held by two horizontal standoff rods (r=0.013). All three cylinders
       are collision primitives on the SAME rigid link - one welded
       assembly, no internal joints. -->
  <link name="handle_grasp">
    <visual>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.25"/></geometry>
      <material name="handle_metal"><color rgba="0.2 0.2 0.22 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.25"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.035 0 0.10" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.013" length="0.07"/></geometry>
      <material name="handle_metal"><color rgba="0.2 0.2 0.22 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.035 0 0.10" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.013" length="0.07"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.035 0 -0.10" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.013" length="0.07"/></geometry>
      <material name="handle_metal"><color rgba="0.2 0.2 0.22 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.035 0 -0.10" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.013" length="0.07"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0.07 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="1.7e-3" iyy="1.7e-3" izz="3.5e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="handle_fixed" type="fixed">
    <parent link="door_leaf"/>
    <child link="handle_grasp"/>
    <origin xyz="0.02 0.65 1.0" rpy="0 0 0"/>
  </joint>

</robot>
